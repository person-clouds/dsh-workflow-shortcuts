{
  "name": "dsh-workflow-shortcuts",
  "version": "0.2.1",
  "type": "module",
  "description": "DSH Web 工作流快捷命令：/D 讨论并落成计划文档；/G 按计划文档或输入文字新建会话处理。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "scripts",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test tests/client.test.mjs tests/index.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/person-clouds/dsh-workflow-shortcuts.git"
  },
  "homepage": "https://github.com/person-clouds/dsh-workflow-shortcuts#readme",
  "bugs": {
    "url": "https://github.com/person-clouds/dsh-workflow-shortcuts/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "workflow",
    "slash-command",
    "plan",
    "session"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  }
}
