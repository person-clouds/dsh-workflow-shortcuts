{
  "version": 1,
  "description": "dsh-workflow-shortcuts 文档 frontmatter 与链接门禁；只校验入口文档，历史 PLAN/STATUS 不批量改造。",
  "include": [
    "SPEC.md",
    "README.md",
    "README.en.md",
    "AGENTS.md"
  ],
  "defaults": {
    "audience": "shared",
    "status": "current"
  },
  "rules": [
    {
      "glob": "AGENTS.md",
      "audience": "ai",
      "status": "current"
    }
  ],
  "plan_status": {
    "glob": [
      "**/PLAN-*.md"
    ],
    "allowed": [
      "not_started",
      "in_progress",
      "fixing",
      "blocked",
      "done",
      "rolled_back"
    ]
  },
  "line_limits": {
    "ai": 120,
    "shared": 200
  },
  "legacy_over_limit": [],
  "required_reading": []
}
